# .env.example — скопируйте в .env и заполните (файл .env никогда не коммитить!)
BOT_TOKEN=123456:ABC-DEF...получите токен у @BotFather

# ---------- Чат-модель ----------
# Вариант 1 — DeepSeek (облако):
#   AI_PROVIDER=deepseek
#   AI_API_KEY=sk-...
#   AI_MODEL=deepseek-chat
#   AI_BASE_URL=            (подставится https://api.deepseek.com/v1)
# Вариант 2 — локальный Ollama:
#   AI_PROVIDER=ollama
#   AI_API_KEY=ollama
#   AI_MODEL=qwen2.5:14b-instruct-q4_K_M
#   AI_BASE_URL=http://localhost:11434/v1
# Вариант 3 — OpenAI:
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_BASE_URL=

# ---------- Эмбеддинги RAG (отдельно от чат-модели) ----------
# DeepSeek не отдаёт эмбеддинги, поэтому векторный индекс живёт на локальном Ollama.
EMBED_MODEL=bge-m3
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama

# Опционально: путь к БД и белый список пользователей (через запятую)
DB_PATH=fitness.db
ALLOWED_USER_IDS=
